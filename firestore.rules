rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsClub(clubId) {
      return signedIn()
        && exists(/databases/$(database)/documents/clubs/$(clubId))
        && get(/databases/$(database)/documents/clubs/$(clubId)).data.get('ownerId', '') == request.auth.uid;
    }
    match /clubs/{clubId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.get('ownerId', request.auth.uid) == request.auth.uid;
      allow update: if signedIn() && (
        (resource.data.get('ownerId', '') == request.auth.uid && request.resource.data.ownerId == request.auth.uid)
        || (resource.data.get('ownerId', '') == '' && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId'])));
      allow delete: if false;
    }
    match /events/{id} {
      allow read: if signedIn();
      allow create: if ownsClub(request.resource.data.clubId);
      allow update: if ownsClub(resource.data.clubId) && request.resource.data.clubId == resource.data.clubId;
      allow delete: if ownsClub(resource.data.clubId);
    }
    match /proposals/{id} {
      allow read: if signedIn();
      allow create: if ownsClub(request.resource.data.clubId);
      allow update, delete: if false;
    }
  }
}
